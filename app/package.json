{
  "name": "avian-visitors-private",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker:dev": "wrangler dev --local --config wrangler.local.jsonc",
    "db:migrate": "wrangler d1 migrations apply avian-visitors --local --config wrangler.local.jsonc",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@resvg/resvg-js": "2.6.2",
    "exifr": "7.1.3",
    "jose": "6.2.13",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "30.1.3",
    "miniflare": "5.20261023.0-beta",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
