{
  "name": "avian-visitors",
  "main": "server/cloud.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/device/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avian-visitors",
      "database_id": "configure-before-deployment",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "avian-visitors-private"
    }
  ],
  "triggers": {
    "crons": [
      "*/1 * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "containers": [
    {
      "class_name": "InferenceContainer",
      "image": "../services/inference/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 1
    },
    {
      "class_name": "RendererContainer",
      "image": "renderer/Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "INFERENCE",
        "class_name": "InferenceContainer"
      },
      {
        "name": "RENDERER",
        "class_name": "RendererContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "containers-v1",
      "new_sqlite_classes": [
        "InferenceContainer",
        "RendererContainer"
      ]
    }
  ]
}
